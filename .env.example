# Copy this file to .env and fill in your own keys. Nothing here is
# committed to git (.env is gitignored) - each self-hosted instance uses
# its own keys and its own data.

# Required - powers photo scanning/identification (Claude vision API).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional - enables live eBay pricing lookups. Without these, live pricing
# is simply skipped; everything else (cataloging, listing text) still works.
# Get production credentials at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Required - photo storage/hosting. Get the URL from your Cloudinary
# dashboard ("API Environment variable", looks like
# cloudinary://<key>:<secret>@<cloud_name>).
CLOUDINARY_URL=
